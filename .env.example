# scholar 本地密钥文件模板：复制为 .env 并填入值（.env 已被 gitignore，不会上传）
# 用法：python scripts/manage_keys.py set <KEY> <value>

# anysearch 搜索 API key（可选，匿名也可用）
ANYSEARCH_API_KEY=

# MinerU 精提取 API Token（仅 extract 模式需要；获取：https://mineru.net/apiManage/token）
MINERU_TOKEN=

# paper-fetch Unpaywall 邮箱（可选，设置后启用 Unpaywall 源）
UNPAYWALL_EMAIL=
